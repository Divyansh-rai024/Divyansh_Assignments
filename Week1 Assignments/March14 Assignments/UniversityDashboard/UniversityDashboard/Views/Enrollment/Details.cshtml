@model UniversityDashboard.Models.StudentDetailVM

<h2>@Model.Name (@Model.Branch)</h2>

<table class="table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Credits</th>
            <th>Department</th>
            <th>Latest Grade</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var c in Model.Courses)
        {
            <tr>
                <td>@c.Title</td>
                <td>@c.Credits</td>
                <td>@c.Department</td>
                <td>@c.LatestGrade</td>
            </tr>
        }

    </tbody>
</table>

<a asp-action="Index">Back</a>