        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Emp": {
      "get": {
        "tags": [
          "Emp"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
